{
  "name": "illuminati-mun-functions",
  "version": "1.0.0",
  "description": "Serverless Cloud Functions for Illuminati International MUN Society",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^22.13.9",
    "typescript": "~5.7.3"
  },
  "private": true
}
